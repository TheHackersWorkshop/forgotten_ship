def fight(player, enemy):
    print(f"A {enemy.name} attacks!")

    while enemy.alive() and player.health > 0:
        dmg = enemy.attack()
        player.health -= dmg
        print(f"The {enemy.name} hits you for {dmg}.")

        if player.health <= 0:
            return False

        enemy.take_damage(10)
        print(f"You hit the {enemy.name}.")

    print(f"The {enemy.name} is dead.")
    return True
